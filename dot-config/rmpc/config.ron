#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    address: "127.0.0.1:6600",
    password: None,
    theme: "~/.config/rmpc/themes/onedark.ron",

    cache_dir: "~/.cache/rmpc/",
    lyrics_dir: "~/.local/share/rmpc/lyrics/",

    on_song_change: ["~/.config/ncmpcpp/music-notif.sh"],

    volume_step: 5,
    max_fps: 30,
    scrolloff: 0,
    wrap_navigation: true,
    enable_mouse: false,
    scroll_amount: 1,
    enable_config_hot_reload: true,
    enable_lyrics_hot_reload: false,
    status_update_interval_ms: 1000,
    rewind_to_start_sec: None,
    keep_state_on_song_change: true,
    reflect_changes_to_playlist: false,
    select_current_song_on_change: false,
    ignore_leading_the: false,
    browser_song_sort: [Disc, Track, Artist, Title],
    directories_sort: SortFormat(group_by_type: true, reverse: false),
    auto_open_downloads: true,

    album_art: (
        method: Kitty,
        max_size_px: (width: 1200, height: 1200),
        disabled_protocols: ["http://", "https://"],
        vertical_align: Center,
        horizontal_align: Center,
    ),

    cava: (
        framerate: 30,
        input: (
            method: Fifo,
            source: "/tmp/mpd.fifo",
            sample_rate: 44100,
            channels: 2,
            sample_bits: 16,
        )
    ),

    keybinds: (
        global: {
            "q":          Quit,
            "?":          ShowHelp,
            ":":          CommandMode,
            "oo":         ShowOutputs,
            "op":         ShowDecoders,
            "od":         ShowDownloads,
            "oP":         Partition(),

            "z":          ToggleRepeat,
            "x":          ToggleRandom,
            "c":          ToggleConsume,
            "v":          ToggleSingle,
            "p":          TogglePause,

            "s":          Stop,
            ">":          NextTrack,
            "<":          PreviousTrack,

            "f":          SeekForward,
            "b":          SeekBack,

            ".":          VolumeUp,
            ",":          VolumeDown,

            "<Tab>":      NextTab,
            "gt":         NextTab,

            "<S-Tab>":    PreviousTab,
            "gT":         PreviousTab,

            "1":          SwitchToTab("Queue-Cava"),
            "2":          SwitchToTab("Directories"),
            "3":          SwitchToTab("Search"),
            "4":          SwitchToTab("Artists"),
            "5":          SwitchToTab("Albums"),
            "6":          SwitchToTab("Playlists"),

            "<C-1>":      SwitchToTab("Queue-Cava"),
            "<C-2>":      SwitchToTab("Queue-Lyrics"),
            "<C-3>":      SwitchToTab("Queue-AlbumArt"),

            "<C-u>":      Update,
            "<C-U>":      Rescan,
            "R":          AddRandom,
        },
        navigation: {
            "<C-c>":      Close,
            "<Esc>":      Close,
            "<CR>":       Confirm,
            "k":          Up,
            "<Up>":       Up,
            "j":          Down,
            "<Down>":     Down,
            "h":          Left,
            "<Left>":     Left,
            "l":          Right,
            "<Right>":    Right,

            "H":          PaneLeft,
            "<C-w>h":     PaneLeft,
            "<C-Left>":   PaneLeft,

            "L":          PaneRight,
            "<C-w>l":     PaneRight,
            "<C-Right>":  PaneRight,

            "K":          MoveUp,
            "J":          MoveDown,

            "<C-u>":      UpHalf,
            "<C-d>":      DownHalf,
            "<C-b>":      PageUp,
            "<PageUp>":   PageUp,
            "<C-f>":      PageDown,
            "<PageDown>": PageDown,

            "gg":         Top,
            "G":          Bottom,

            "<Space>":    Select,
            "<C-Space>":  InvertSelection,
            "/":          EnterSearch,
            "n":          NextResult,
            "N":          PreviousResult,

            "a":          Add,
            "A":          AddAll,
            "D":          Delete,
            "<C-r>":      Rename,

            "I":          FocusInput,
            "i":          ShowInfo,
            "<C-z>":      ContextMenu(),

            "<C-s>s":     Save(kind: Modal(all: false, duplicates_strategy: Ask)),
            "<C-s>a":     Save(kind: Modal(all: true, duplicates_strategy: Ask)),
        },
        queue: {
            "d":          Delete,
            "D":          DeleteAll,
            "<CR>":       Play,
            "C":          JumpToCurrent,
            "Z":          Shuffle,
        },
    ),
    search: (
        case_sensitive: false,
        ignore_diacritics: false,
        search_button: false,
        mode: Contains,
        tags: [
            (value: "any",         label: "Any Tag"),
            (value: "artist",      label: "Artist"),
            (value: "album",       label: "Album"),
            (value: "albumartist", label: "Album Artist"),
            (value: "title",       label: "Title"),
            (value: "filename",    label: "Filename"),
            (value: "genre",       label: "Genre"),
        ],
    ),
    artists: (
        album_display_mode: SplitByDate,
        album_sort_by: Date,
        album_date_tags: [Date],
    ),
    tabs: [
        (
            name: "Queue-Cava",
            pane: Split(
                direction: Horizontal,
                panes: [(
                    size: "60%",
                    borders: "NONE",
                    border_symbols: Rounded,
                    pane: Pane(Queue),
                ),
                (
                    size: "40%",
                    pane: Pane(Cava)
                )],
            ),
        ),

        (
            name: "Queue-Lyrics",
            pane: Split(
                direction: Horizontal,
                panes: [(
                    size: "60%",
                    borders: "NONE",
                    border_symbols: Rounded,
                    pane: Pane(Queue),
                ),
                (
                    size: "40%",
                    pane: Pane(Lyrics)
                )],
            ),
        ),

        (
            name: "Queue-AlbumArt",
            pane: Split(
                direction: Horizontal,
                panes: [(
                    size: "60%",
                    borders: "NONE",
                    border_symbols: Rounded,
                    pane: Pane(Queue),
                ),
                (
                    size: "40%",
                    pane: Pane(AlbumArt)
                )],
            ),
        ),

        (
            name: "Directories",
            borders: "NONE",
            border_symbols: Rounded,
            pane: Split(
                direction: Horizontal,
                panes: [
                    (
                        size: "40%",
                        borders: "NONE",
                        border_symbols: Rounded,
                        pane: Pane(Queue),
                    ),
                    (
                        size: "60%",
                        borders: "NONE",
                        border_symbols: Rounded,
                        pane: Pane(Directories),
                        horizontal_align: Left
                    )
                ],
            ),
        ),

        (
            name: "Search",
            borders: "NONE",
            border_symbols: Rounded,
            pane: Split(
                direction: Horizontal,
                panes: [
                    (
                        size: "40%",
                        borders: "NONE",
                        border_symbols: Rounded,
                        pane: Pane(Queue),
                    ),
                    (
                        size: "60%",
                        borders: "NONE",
                        border_symbols: Rounded,
                        pane: Pane(Search),
                        horizontal_align: Left
                    )
                ],
            ),
        ),

        (
            name: "Artists",
            borders: "NONE",
            border_symbols: Rounded,
            pane: Split(
                direction: Horizontal,
                panes: [
                    (
                        size: "40%",
                        borders: "NONE",
                        border_symbols: Rounded,
                        pane: Pane(Queue),
                    ),
                    (
                        size: "60%",
                        borders: "NONE",
                        border_symbols: Rounded,
                        pane: Pane(Artists),
                        horizontal_align: Left
                    )
                ],
            ),
        ),

        (
            name: "Albums",
            borders: "NONE",
            border_symbols: Rounded,
            pane: Split(
                direction: Horizontal,
                panes: [
                    (
                        size: "40%",
                        borders: "NONE",
                        border_symbols: Rounded,
                        pane: Pane(Queue),
                    ),
                    (
                        size: "60%",
                        borders: "NONE",
                        border_symbols: Rounded,
                        pane: Pane(Albums),
                        horizontal_align: Left
                    )
                ],
            ),
        ),

        (
            name: "Playlists",
            borders: "NONE",
            border_symbols: Rounded,
            pane: Split(
                direction: Horizontal,
                panes: [
                    (
                        size: "40%",
                        borders: "NONE",
                        border_symbols: Rounded,
                        pane: Pane(Queue),
                    ),
                    (
                        size: "60%",
                        borders: "NONE",
                        border_symbols: Rounded,
                        pane: Pane(Playlists),
                        horizontal_align: Left
                    )
                ],
            ),
        ),
    ],
)
